rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /registrations/{id} {
      allow create: if request.resource.data.keys().hasOnly(['first','last','age','at'])
        && request.resource.data.first is string && request.resource.data.first.size() > 0 && request.resource.data.first.size() <= 40
        && request.resource.data.last is string && request.resource.data.last.size() > 0 && request.resource.data.last.size() <= 40
        && request.resource.data.age is int && request.resource.data.age > 0 && request.resource.data.age < 121;
      allow read, delete: if request.auth != null && request.auth.token.email == 'admin@reg.app';
    }
  }
}
